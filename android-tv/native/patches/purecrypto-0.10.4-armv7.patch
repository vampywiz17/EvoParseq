--- a/src/tls/crypto/aead12.rs
+++ b/src/tls/crypto/aead12.rs
@@ -109,6 +109,56 @@ enum NonceScheme {
     Xor { iv: [u8; 12] },
 }
 
+#[cfg(not(all(feature = "evoparseq-armv7-aes-gcm", target_arch = "arm")))]
+type RecordAead12 = Aead;
+
+// Use the measured RustCrypto software AES only in the opt-in 32-bit ARM
+// record layer. The existing DTLS code still owns nonce construction, AAD,
+// record limits and replay state.
+#[cfg(all(feature = "evoparseq-armv7-aes-gcm", target_arch = "arm"))]
+enum RecordAead12 {
+    Aes128(aes_gcm::Aes128Gcm),
+    Aes256(aes_gcm::Aes256Gcm),
+    Other(Aead),
+}
+
+#[cfg(all(feature = "evoparseq-armv7-aes-gcm", target_arch = "arm"))]
+impl RecordAead12 {
+    fn from_key(alg: AeadAlg, key: &[u8]) -> Self {
+        use aes_gcm::KeyInit;
+        match alg {
+            AeadAlg::Aes128Gcm => Self::Aes128(
+                aes_gcm::Aes128Gcm::new_from_slice(key).expect("TLS 1.2 AES-128 key length"),
+            ),
+            AeadAlg::Aes256Gcm => Self::Aes256(
+                aes_gcm::Aes256Gcm::new_from_slice(key).expect("TLS 1.2 AES-256 key length"),
+            ),
+            AeadAlg::ChaCha20Poly1305 => Self::Other(Aead::from_key(alg, key)),
+        }
+    }
+
+    fn encrypt(&self, nonce: &[u8; 12], aad: &[u8], body: &mut [u8]) -> [u8; 16] {
+        use aes_gcm::aead::AeadInPlace;
+        match self {
+            Self::Aes128(gcm) => gcm.encrypt_in_place_detached(nonce.into(), aad, body),
+            Self::Aes256(gcm) => gcm.encrypt_in_place_detached(nonce.into(), aad, body),
+            Self::Other(aead) => return aead.encrypt(nonce, aad, body),
+        }
+        .expect("bounded TLS 1.2 record")
+        .into()
+    }
+
+    fn decrypt(&self, nonce: &[u8; 12], aad: &[u8], body: &mut [u8], tag: &[u8; 16]) -> bool {
+        use aes_gcm::aead::AeadInPlace;
+        match self {
+            Self::Aes128(gcm) => gcm.decrypt_in_place_detached(nonce.into(), aad, body, tag.into()),
+            Self::Aes256(gcm) => gcm.decrypt_in_place_detached(nonce.into(), aad, body, tag.into()),
+            Self::Other(aead) => return aead.decrypt(nonce, aad, body, tag),
+        }
+        .is_ok()
+    }
+}
